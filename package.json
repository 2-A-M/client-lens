{
    "name": "@elizaos-plugins/client-lens",
    "version": "1.0.0",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup --format esm --dts",
        "dev": "tsup --format esm --dts --watch",
        "lint": "eslint --fix --cache .",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "ethers": "^6.13.0"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^1.2.1",
        "tsup": "^8.3.5",
        "typescript": "^5.9.3",
        "vitest": "^3.0.0"
    },
    "peerDependencies": {
        "@elizaos/core": "*"
    },
    "publishConfig": {
        "access": "public"
    },
    "agentConfig": {
        "pluginType": "elizaos:client:1.0.0",
        "pluginParameters": {
            "LENS_API_KEY": {
                "type": "string",
                "description": "Lens app Server API Key from developer.lens.xyz"
            },
            "LENS_ACCOUNT_ADDRESS": {
                "type": "string",
                "description": "Lens account address (EVM address)"
            },
            "LENS_PRIVATE_KEY": {
                "type": "string",
                "description": "Wallet private key for signing (0x + 64 hex)",
                "sensitive": true
            },
            "LENS_APP_ADDRESS": {
                "type": "string",
                "description": "Lens app contract address from developer.lens.xyz"
            },
            "LENS_POLL_INTERVAL": {
                "type": "number",
                "description": "Seconds between mention checks (default: 120)",
                "optional": true
            },
            "LENS_DRY_RUN": {
                "type": "boolean",
                "description": "Preview mode without posting",
                "optional": true
            }
        }
    }
}
